{
  "name": "floating-quran",
  "productName": "Floating Quran",
  "version": "0.5.0",
  "description": "Quran recitation with floating subtitles above every window",
  "main": "src/main.js",
  "author": "Elnur Suyunov",
  "license": "MIT",
  "homepage": "https://github.com/Elnurrabbimov/floatingquran",
  "repository": {
    "type": "git",
    "url": "https://github.com/Elnurrabbimov/floatingquran.git"
  },
  "scripts": {
    "start": "electron .",
    "icons": "electron scripts/make-icons.js",
    "dist:mac": "electron-builder --mac",
    "dist:win": "electron-builder --win",
    "dist:linux": "electron-builder --linux",
    "dist:all": "electron-builder --mac --win --linux"
  },
  "build": {
    "appId": "uz.suzuvchiquron.app",
    "productName": "Floating Quran",
    "artifactName": "FloatingQuran-${version}-${os}-${arch}.${ext}",
    "files": [
      "src/**/*",
      "package.json"
    ],
    "mac": {
      "category": "public.app-category.education",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "identity": null,
      "hardenedRuntime": false
    },
    "afterPack": "build/afterPack.js",
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Floating Quran"
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        }
      ],
      "category": "Education",
      "maintainer": "Elnur Suyunov",
      "synopsis": "Floating Quran subtitles above every window"
    },
    "dmg": {
      "title": "Floating Quran"
    }
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "dependencies": {
    "koffi": "^2.16.4"
  }
}
